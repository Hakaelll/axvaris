{
  "name": "sabicheiro-desktop",
  "version": "0.4.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --mode preview",
    "dev:tauri": "vite --host 127.0.0.1 --port 1420 --mode tauri",
    "build": "tsc -b && vite build",
    "check": "node scripts/audit-i18n.mjs && node scripts/test-ui.mjs && tsc -b --pretty false && vite build",
    "audit:i18n": "node scripts/audit-i18n.mjs",
    "lint": "tsc -b --pretty false",
    "format": "prettier --write src \"*.{json,ts,html}\"",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1",
    "topojson-client": "3.1.0",
    "world-atlas": "2.0.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.185.0",
    "@types/topojson-client": "3.1.5",
    "@types/topojson-specification": "1.0.5",
    "@vitejs/plugin-react": "6.0.4",
    "prettier": "3.6.2",
    "typescript": "7.0.2",
    "vite": "8.1.5"
  }
}
