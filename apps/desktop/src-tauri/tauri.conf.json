{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sabicheiro",
  "version": "0.4.2",
  "identifier": "io.sabicheiro.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev:tauri",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Sabicheiro",
        "width": 1440,
        "height": 900,
        "minWidth": 720,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "backgroundColor": "#08090a"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage", "deb"],
    "category": "Utility",
    "shortDescription": "Private local network observability",
    "longDescription": "Sabicheiro visualizes the network connections made by this computer using local processing and storage.",
    "copyright": "Copyright © 2026 Sabicheiro contributors",
    "publisher": "Sabicheiro contributors",
    "license": "MIT",
    "licenseFile": "../../../LICENSE",
    "resources": {
      "../../../DEPENDENCIES.md": "notices/DEPENDENCIES.md",
      "../../../PRIVACY.md": "notices/PRIVACY.md",
      "../../../THIRD_PARTY_NOTICES.md": "notices/THIRD_PARTY_NOTICES.md"
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "startMenuFolder": "Sabicheiro"
      },
      "wix": null
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      },
      "deb": {
        "depends": []
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
